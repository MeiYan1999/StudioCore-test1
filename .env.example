# Kho dữ liệu SQLite local. Production chuyển sang PostgreSQL theo PLAN.
DATABASE_URL=./data/studiocore.db

# Bắt buộc: chuỗi ngẫu nhiên tối thiểu 32 byte, dùng ký session cookie.
AUTH_SECRET=replace-with-a-random-32-byte-hex-string

# Thời hạn phiên đăng nhập (giờ).
SESSION_TTL_HOURS=8

# URL công khai dùng cho canonical/OG ở Phase 6.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Storage: local cho demo; r2 khuyên dùng cho production (miễn phí 100% băng thông tải về)
STORAGE_PROVIDER=local

# Cloudflare R2 Object Storage
# Lấy tại Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=studiocore-data
# Tùy chọn: Tên miền R2 dev hoặc Custom Domain (VD: https://media.studiocore.io.vn hoặc https://pub-xxx.r2.dev)
R2_PUBLIC_URL=

# Thư mục uploads. Mặc định public/uploads; Render dùng /app/data/uploads trên persistent disk.
# UPLOAD_ROOT=

# Khóa mã hóa token chia sẻ PhotoShare và refresh token Drive.
# Bắt buộc ở production; nếu bỏ trống sẽ dùng AUTH_SECRET cho môi trường demo.
TOKEN_ENCRYPTION_KEY=

# Google Drive OAuth (để trống nếu chỉ dùng Drive demo local).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# AI Hub: mặc định local heuristic, không gọi mạng.
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=
AI_MONTHLY_BUDGET_VND=0

# Payment adapter: manual hoặc vietqr. Mock webhook chỉ chạy ở development.
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
