#!/usr/bin/env bash
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
NODE_BIN="$(cat "$HOME/.studiocore-drive/node-path" 2>/dev/null || command -v node || true)"
if [ ! -x "$NODE_BIN" ]; then
    osascript -e 'display alert "StudioCore Drive — Thiếu Node.js" message "Vui lòng cài đặt Node.js từ https://nodejs.org để chạy ứng dụng." as warning'
    open "https://nodejs.org"
    exit 1
fi

exec "$NODE_BIN" "$HOME/.studiocore-drive/app/cli.js" open
