{
  "name": "studiocore-drive",
  "productName": "StudioCore Drive",
  "version": "2.1.0",
  "description": "Gửi ảnh và video cho khách thẳng từ máy tính studio.",
  "author": "StudioCore",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --config electron-builder.config.js --mac dmg --x64 --arm64 --publish never"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "electron": "43.7.7",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "vn.io.studiocore.drive",
    "productName": "StudioCore Drive",
    "artifactName": "StudioCore-Drive-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/icon.png",
      "assets/tray.png",
      "assets/mac-quick-action/**/*"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.photography",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "StudioCore Drive cần quyền này một lần để gỡ mục khởi động cùng máy cũ còn sót trong Cài đặt hệ thống.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "CFBundleTypeOSTypes": [
              "fold"
            ],
            "LSItemContentTypes": [
              "public.folder",
              "public.directory"
            ]
          }
        ]
      }
    }
  }
}
